---
import Head from '../components/Head.astro';
import { getEntry } from 'astro:content';
import Seo from '../components/Seo.astro';
import ProfileHeader from '../components/sections/ProfileHeader.astro';
import Experience from '../components/sections/Experience.astro';
import Education from '../components/sections/Education.astro';
import Publications from '../components/sections/Publications.astro';
import Skills from '../components/sections/Skills.astro';
import Footer from '../components/Footer.astro';

const profile = (await getEntry('profile', 'main'))!.data;

const title = profile.name;
const description = `${profile.name}, ${profile.title} based in ${profile.location}. Curriculum vitae.`;

// Link preview card, generated in the site's type and colours.
const image = {
	src: '/og.png',
	alt: `${profile.name}, ${profile.title}. Curriculum vitae.`,
	width: 1200,
	height: 630,
};

// schema.org Person, so search engines can show a profile card.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.title,
	address: { '@type': 'PostalAddress', addressLocality: profile.location },
	sameAs: profile.links.map((link) => link.href).filter((href) => href.startsWith('http')),
	...(Astro.site && { url: Astro.site.href }),
};
---

<html lang="en">
	<Head>
		<Seo title={title} description={description} image={image} jsonLd={jsonLd} />
	</Head>
	<body>
		<main>
			<ProfileHeader />
			<Experience />
			<Education />
			<Publications />
			<Skills />
			<Footer />
		</main>
	</body>
</html>

