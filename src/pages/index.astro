---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import Seo from '../components/Seo.astro';
import ProfileHeader from '../components/sections/ProfileHeader.astro';
import Experience from '../components/sections/Experience.astro';
import Education from '../components/sections/Education.astro';
import Publications from '../components/sections/Publications.astro';
import Skills from '../components/sections/Skills.astro';

const profile = (await getEntry('profile', 'main'))!.data;

const title = profile.name;
const description =
	profile.summary ?? `${profile.name}, ${profile.title} based in ${profile.location}. Curriculum vitae.`;

// schema.org Person, so search engines can show a profile card.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.title,
	address: { '@type': 'PostalAddress', addressLocality: profile.location },
	sameAs: profile.links.map((link) => link.href).filter((href) => href.startsWith('http')),
	...(Astro.site && { url: Astro.site.href }),
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- Cascade layer order, before any stylesheet. Layers are ordered by
		     first appearance, and component styles can be injected ahead of
		     global.css, so the order can't depend on import order. -->
		<style is:inline>
			@layer reset, tokens, base, components, utilities;
		</style>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- The .ico declares its size so browsers that support SVG favicons
		     pick the SVG. -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} jsonLd={jsonLd} />
		<Font cssVariable="--font-eb-garamond" preload />
	</head>
	<body>
		<main>
			<ProfileHeader />
			<Experience />
			<Education />
			<Publications />
			<Skills />
		</main>
	</body>
</html>

<style>
	@layer components {
		main {
			/* The text column, centred. Entry dates hang in the left margin. */
			max-inline-size: calc(var(--measure) + 2 * var(--side));
			margin-inline: auto;
			padding-inline: var(--side);
			padding-block: var(--space-xl-2xl) var(--space-2xl-3xl);
		}
	}
</style>
