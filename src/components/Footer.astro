---
import { getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'main'))!.data;
// The build year: the site is static, so the range moves on with each deploy.
const year = new Date().getFullYear();
const years = year > 2025 ? `2025–${year}` : '2025';
---

<footer class="muted">
	<p class="copyright">© {years} {profile.name}</p>
	<ul class="links">
		<li>Built with <a href="https://astro.build">Astro</a></li>
		<li><a href="https://github.com/kurabirko/utkubirkan.com">Source code</a></li>
	</ul>
	<address>
		{
			profile.address.map((line, i) => (
				<>
					{i > 0 && <br />}
					{line}
				</>
			))
		}
	</address>
</footer>

<style>
	@layer components {
		/* Quiet gray small print in three columns at the end of the page:
		   copyright, site links, business address. */
		footer {
			margin-block-start: var(--space-2xl-3xl);
			display: grid;
			grid-template-columns: repeat(3, auto);
			justify-content: space-between;
			align-items: start;
			gap: var(--space-m) var(--space-l);
			font-family: var(--font-display);
			font-weight: 300;
			font-size: 0.9rem;
			line-height: 1.5;
		}
		.links {
			padding: 0;
			list-style: none;
		}
		/* The same gap as between the address's lines (1.5 line height minus
		   Jost's 0.7em cap height), as both are trimmed to their letters. */
		.links li + li {
			margin-block-start: 0.8em;
		}
		address {
			font-style: normal;
			text-box: trim-both cap alphabetic;
		}
		/* Links stay gray, without the rubric tint links get elsewhere, and
		   darken to the ink colour on hover (lighten, in dark mode). */
		a {
			text-decoration-color: color-mix(in oklch, currentColor 45%, transparent);
		}
		a:hover {
			color: var(--ink);
		}
		@media print {
			footer {
				display: none;
			}
		}
		/* Phones: the columns stack, centred. */
		@media screen and (max-width: 32rem) {
			footer {
				grid-template-columns: 1fr;
				justify-items: center;
				text-align: center;
			}
		}
	}
</style>
