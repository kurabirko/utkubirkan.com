---
// Everything search engines and link previews read from <head>. Absolute URLs
// (canonical, og:url) need `site` in astro.config.mjs and are left out until
// it's set.
interface Props {
	title: string;
	description: string;
	/** Link preview image in public/, ideally 1200×630. */
	image?: { src: string; alt: string; width: number; height: number };
	/** schema.org structured data, serialized as JSON-LD. */
	jsonLd?: Record<string, unknown>;
}

const { title, description, image, jsonLd } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Link previews need an absolute image URL.
const imageUrl = image && Astro.site ? new URL(image.src, Astro.site).href : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content="profile" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{
	image && imageUrl && (
		<>
			<meta property="og:image" content={imageUrl} />
			<meta property="og:image:width" content={String(image.width)} />
			<meta property="og:image:height" content={String(image.height)} />
			<meta property="og:image:alt" content={image.alt} />
		</>
	)
}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />

<!-- Browser UI colour, matching --paper in each theme. -->
<meta name="theme-color" content="#fcfaf7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141211" media="(prefers-color-scheme: dark)" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
