---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('Missing "main" entry in src/content/profile.yaml');
const { name, title, location, summary, links } = profile.data;
---

<header>
	<h1>{name}</h1>
	<p class="meta">{title} · {location}</p>
	{summary && <p class="summary">{summary}</p>}
	<nav>
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>
</header>

<style>
	@layer components {
		header {
			margin-bottom: var(--space-xl-2xl);
		}
		h1 {
			font-size: 2.5rem;
			letter-spacing: -0.02em;
		}
		.meta {
			color: var(--muted);
			margin-top: var(--space-s);
		}
		.summary {
			margin-top: var(--space-s-m);
		}
		nav {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-xs) var(--space-s-m);
			margin-top: var(--space-s-m);
		}
		nav a {
			text-box: trim-both cap alphabetic;
		}
	}
</style>
