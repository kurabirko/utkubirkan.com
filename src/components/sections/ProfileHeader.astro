---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('Missing "main" entry in src/content/profile.yaml');
const { name, title, location, summary, links } = profile.data;
---

<header>
	<p class="kicker small-caps rubric">{title}</p>
	<h1>{name}</h1>
	<p class="location muted">{location}</p>
	{summary && <p class="summary">{summary}</p>}
	<nav>
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>
</header>

<style>
	@layer components {
		.kicker {
			margin-bottom: var(--space-s);
		}
		h1 {
			font-size: 3.6rem;
			line-height: 1.02;
		}
		.location {
			margin-top: var(--space-s);
		}
		.summary {
			margin-top: var(--space-m);
			font-size: 1.3rem;
		}
		nav {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-xs) var(--space-m);
			margin-top: var(--space-m);
		}
		nav a {
			text-box: trim-both cap alphabetic;
		}
		@media (max-width: 32rem) {
			h1 {
				font-size: 2.8rem;
			}
		}
	}
</style>
