---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('Missing "main" entry in src/content/profile.yaml');
const { name, title, location, summary, links } = profile.data;
---

<header>
	<div class="hero">
		<p class="kicker rubric">{title}</p>
		<h1>{name}</h1>
		<p class="location muted">{location}</p>
		{summary && <p class="summary">{summary}</p>}
		<nav>
			{
				links.map((link, i) => (
					<>
						{i > 0 && <span class="divider" aria-hidden="true">·</span>}
						<a href={link.href}>{link.label}</a>
					</>
				))
			}
		</nav>
	</div>
</header>

<style>
	@layer components {
		/* Hero: fills the first screen with the name set large, so that the
		   first section's label sits just above the bottom of the viewport and
		   nothing below it shows. Font sizes are fixed (not fluid), in rem,
		   and step down at breakpoints. */
		header {
			--kicker-size: 0.98;
			--name-size: 7;
			--line-size: 1.6;
			--nav-size: 1.3;
			/* The viewport less main's top padding, the section spacing, the
			   label (1.2rem trimmed to EB Garamond's 0.65em cap height) and a
			   gap under it, smaller than the label's own space-l gap to the
			   first entry so that entry stays out of view; at least 20rem on
			   short landscape screens. */
			--hero-h: max(
				20rem,
				calc(100svb - var(--space-xl-2xl) - var(--space-2xl-3xl) - 0.78rem - var(--space-m))
			);

			min-block-size: var(--hero-h);
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-block: var(--space-l);
		}
		/* Small capitals set as capitals at 70%, which is what the browser
		   synthesises for small-caps anyway (the font has no small-cap glyphs),
		   but drawn from the regular glyphs, so they scale smoothly in the
		   scroll animation instead of snapping between pixel sizes. Sizes are
		   the small-caps sizes × 0.7. */
		.kicker {
			text-transform: uppercase;
			font-size: calc(var(--kicker-size) * 1rem);
			letter-spacing: 0.143em;
		}
		h1 {
			margin-block-start: var(--space-m);
			font-size: calc(var(--name-size) * 1rem);
			line-height: 0.92;
			letter-spacing: -0.01em;
		}
		.location {
			margin-block-start: var(--space-m-l);
			font-size: calc(var(--line-size) * 1rem);
		}
		.summary {
			margin-block-start: var(--space-m);
			font-size: 1.5rem;
			max-inline-size: 32ch;
		}
		nav {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: var(--space-xs) var(--space-s);
			margin-block-start: var(--space-l);
			font-size: calc(var(--nav-size) * 1rem);
		}
		nav > * {
			text-box: trim-both cap alphabetic;
		}
		/* A middle dot, a touch heavier and larger than the text so it reads at
		   this size without becoming a full bullet. */
		.divider {
			color: var(--muted);
			font-weight: 600;
			font-size: 1.15em;
		}
		@media (max-width: 48rem) {
			header {
				--name-size: 5;
			}
		}
		@media (max-width: 32rem) {
			header {
				--kicker-size: 0.805;
				--name-size: 3.25;
				--line-size: 1.3;
				--nav-size: 1.2;
			}
			.summary {
				font-size: 1.3rem;
			}
		}

		/* Progressive enhancement: where scroll-driven animations are supported
		   (and motion is welcome), the hero stays in place while the content
		   scrolls up towards it, shrinking, rising towards the top and drawing
		   its lines together. The header keeps a fixed height and the .hero
		   inside it is sticky, so it is released, and scrolls away with the
		   page, when the first section reaches it at the normal section
		   spacing. The shrink ends at that same moment, so the section arrives
		   without any extra space. Elsewhere the static hero above is used as
		   is. */
		@supports (animation-timeline: scroll()) {
			@media screen and (prefers-reduced-motion: no-preference) {
				/* Registered so they compute to lengths on the header, where 1cap
				   is the cap height of 1rem text, and are inherited as lengths. */
				@property --hero-full-h {
					syntax: '<length>';
					inherits: true;
					initial-value: 0px;
				}
				@property --hero-compact-h {
					syntax: '<length>';
					inherits: true;
					initial-value: 0px;
				}
				header {
					/* Where the hero ends up, and its compact font sizes in rem. */
					--inset-end: var(--space-l);
					--kicker-compact: 0.77;
					--name-compact: 3.5;
					--line-compact: 1.2;
					--nav-compact: 1.1;
					/* Heights of the full and compact hero: every line is trimmed to
					   its cap height (the nav to its 1.15em divider's), plus the
					   gaps. */
					--hero-full-h: calc(
						1cap *
							(var(--kicker-size) + var(--name-size) + var(--line-size) +
								var(--nav-size) * 1.15) +
							var(--space-m) + var(--space-m-l) + var(--space-l)
					);
					--hero-compact-h: calc(
						1cap *
							(var(--kicker-compact) + var(--name-compact) + var(--line-compact) +
								var(--nav-compact) * 1.15) +
							2 * var(--space-xs) + var(--space-s)
					);
					/* Via a custom property so the minifier keeps animation-timeline
					   as its own declaration instead of folding it into the
					   animation shorthand, which doesn't accept it everywhere. */
					--timeline: scroll(root);
					/* Shrink until the release: the scroll at which the header's
					   bottom (main's top padding plus its height down the page)
					   meets the compact hero's bottom. */
					--range: 0
						calc(var(--space-xl-2xl) + var(--hero-h) - var(--inset-end) - var(--hero-compact-h));

					display: block;
					min-block-size: 0;
					block-size: var(--hero-h);
					padding-block: 0;
					/* So 1cap above is the cap height of 1rem text; every child sets
					   its own size. */
					font-size: 1rem;
				}
				/* Pinned centred in the header, as in the static layout, then
				   drawn up towards the top. */
				.hero {
					position: sticky;
					inset-block-start: calc(var(--space-xl-2xl) + (var(--hero-h) - var(--hero-full-h)) / 2);
					animation-name: hero-top;
				}
				.hero,
				.kicker,
				h1,
				.location,
				.summary,
				nav {
					/* Longhands: a nameless shorthand gets minified to animation: none. */
					animation-timing-function: linear;
					animation-fill-mode: both;
					animation-timeline: var(--timeline);
					animation-range: var(--range);
				}
				/* Each gap moves from the next line's margin-block-start to this
				   line's padding-block-end, set only by the animation (from --gap to
				   --gap-end): Safari leaves a spacing property at its start
				   value here when a normal rule on the element also sets it. */
				h1,
				.location,
				.summary,
				nav {
					margin-block-start: 0;
				}
				.kicker {
					--gap: var(--space-m);
					--gap-end: var(--space-xs);
				}
				h1 {
					--gap: var(--space-m-l);
					--gap-end: var(--space-xs);
				}
				.location,
				.summary {
					--gap: var(--space-l);
					--gap-end: var(--space-s);
				}
				.location:has(+ .summary) {
					--gap: var(--space-m);
					--gap-end: var(--space-xs);
				}
				.kicker {
					animation-name: hero-kicker;
				}
				h1 {
					animation-name: hero-name;
				}
				.location,
				.summary {
					animation-name: hero-line;
				}
				nav {
					animation-name: hero-nav;
				}
				@keyframes hero-top {
					to {
						inset-block-start: var(--inset-end);
					}
				}
				@keyframes hero-kicker {
					from {
						padding-block-end: var(--gap);
					}
					to {
						padding-block-end: var(--gap-end);
						font-size: calc(var(--kicker-compact) * 1rem);
					}
				}
				@keyframes hero-name {
					from {
						padding-block-end: var(--gap);
					}
					to {
						padding-block-end: var(--gap-end);
						font-size: calc(var(--name-compact) * 1rem);
					}
				}
				@keyframes hero-line {
					from {
						padding-block-end: var(--gap);
					}
					to {
						padding-block-end: var(--gap-end);
						font-size: calc(var(--line-compact) * 1rem);
					}
				}
				@keyframes hero-nav {
					to {
						font-size: calc(var(--nav-compact) * 1rem);
					}
				}
				@media (max-width: 48rem) {
					header {
						--name-compact: 3;
					}
				}
				@media (max-width: 32rem) {
					header {
						--name-compact: 2.25;
					}
				}
			}
		}
	}
</style>
