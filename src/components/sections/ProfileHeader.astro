---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('Missing "main" entry in src/content/profile.yaml');
const { name, title, location, summary, links } = profile.data;
---

<header>
	<div class="hero">
		<p class="kicker small-caps rubric">{title}</p>
		<h1>{name}</h1>
		<p class="location muted">{location}</p>
		{summary && <p class="summary">{summary}</p>}
		<nav>
			{
				links.map((link, i) => (
					<>
						{i > 0 && <span class="divider" aria-hidden="true">·</span>}
						<a href={link.href}>{link.label}</a>
					</>
				))
			}
		</nav>
	</div>
</header>

<style>
	@layer components {
		/* Hero: fills most of the first screen with the name set large, and
		   steps down at breakpoints (font sizes are fixed, not fluid). */
		header {
			min-height: min(66svh, 40rem);
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-block: var(--space-l) var(--space-xl);
		}
		.kicker {
			font-size: 1.4rem;
			letter-spacing: 0.1em;
		}
		h1 {
			margin-top: var(--space-m);
			font-size: 7rem;
			line-height: 0.92;
			letter-spacing: -0.01em;
		}
		.location {
			margin-top: var(--space-m-l);
			font-size: 1.6rem;
		}
		.summary {
			margin-top: var(--space-m);
			font-size: 1.5rem;
			max-width: 32ch;
		}
		nav {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: var(--space-xs) var(--space-s);
			margin-top: var(--space-l);
			font-size: 1.3rem;
		}
		nav > * {
			text-box: trim-both cap alphabetic;
		}
		/* A middle dot, a touch heavier and larger than the text so it reads at
		   this size without becoming a full bullet. */
		.divider {
			color: var(--muted);
			font-weight: 600;
			font-size: 1.15em;
		}
		@media (max-width: 48rem) {
			h1 {
				font-size: 5rem;
			}
		}
		@media (max-width: 32rem) {
			header {
				min-height: min(60svh, 30rem);
			}
			.kicker {
				font-size: 1.15rem;
			}
			h1 {
				font-size: 3.25rem;
			}
			.location,
			.summary {
				font-size: 1.3rem;
			}
			nav {
				font-size: 1.2rem;
			}
		}

		/* Progressive enhancement: where scroll-driven animations are supported
		   (and motion is welcome), the hero stays in place while the content
		   scrolls up towards it, shrinking and drawing its lines together. The
		   header keeps a fixed height and the .hero inside it is sticky, so it
		   is released, and scrolls away with the page, exactly when the first
		   section reaches it (at the normal section spacing). Elsewhere the
		   static hero above is used as is. */
		@supports (animation-timeline: scroll()) {
			@media screen and (prefers-reduced-motion: no-preference) {
				header {
					--hero-h: min(66svh, 40rem);
					--name-compact: 3.5rem;
					/* Via a custom property so the minifier keeps animation-timeline
					   as its own declaration instead of folding it into the
					   animation shorthand, which doesn't accept it everywhere. */
					--timeline: scroll(root);
					/* Finish shrinking before the first section arrives. */
					--range: 0 calc(var(--hero-h) * 0.3);

					display: block;
					min-height: 0;
					height: var(--hero-h);
					padding-block: 0;
				}
				/* Pinned where it sits in the static layout: main's top padding plus
				   a share of the hero height. */
				.hero {
					position: sticky;
					top: calc(var(--space-xl-2xl) + var(--hero-h) * 0.35);
				}
				.kicker,
				h1,
				.location,
				.summary,
				nav {
					/* Longhands: a nameless shorthand gets minified to animation: none. */
					animation-timing-function: linear;
					animation-fill-mode: both;
					animation-timeline: var(--timeline);
					animation-range: var(--range);
				}
				.kicker {
					animation-name: hero-kicker;
				}
				h1 {
					animation-name: hero-name;
				}
				.location,
				.summary {
					animation-name: hero-line;
				}
				nav {
					animation-name: hero-nav;
				}
				@keyframes hero-kicker {
					to {
						font-size: 1.1rem;
					}
				}
				@keyframes hero-name {
					to {
						margin-top: var(--space-xs);
						font-size: var(--name-compact);
					}
				}
				@keyframes hero-line {
					to {
						margin-top: var(--space-xs);
						font-size: 1.2rem;
					}
				}
				@keyframes hero-nav {
					to {
						margin-top: var(--space-s);
						font-size: 1.1rem;
					}
				}
				@media (max-width: 48rem) {
					header {
						--name-compact: 3rem;
					}
				}
				@media (max-width: 32rem) {
					header {
						--hero-h: min(60svh, 30rem);
						--name-compact: 2.25rem;
					}
				}
			}
		}
	}
</style>
