---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('Missing "main" entry in src/content/profile.yaml');
const { name, title, links, address: businessAddress } = profile.data;

// On paper a link has to show where it goes: "LinkedIn" prints as
// linkedin.com/in/…. Labels that already are the address print as they are.
const address = (href: string) => href.replace(/^mailto:/, '').replace(/^https?:\/\/(www\.)?/, '');

// The CV as a PDF, printed from this page at build time (scripts/build-pdf.ts).
const pdf = '/utku-birkan-cv.pdf';
---

<header>
	<div class="hero">
		<p class="kicker rubric">{title}</p>
		<h1>{name}</h1>
		<nav>
			<a class="screen-only" href={pdf} download={`${name} CV.pdf`}>CV</a>
			{
				links.map((link, i) => (
					<>
						{/* On phones the dot before the second link breaks the line. */}
						<span class:list={['divider', { 'screen-only': i === 0, 'row-break': i === 1 }]} aria-hidden="true">·</span>
						<a href={link.href}>
							{address(link.href) === link.label ? (
								link.label
							) : (
								<>
									<span class="screen-label">{link.label}</span>
									<span class="print-label">{address(link.href)}</span>
								</>
							)}
						</a>
					</>
				))
			}
		</nav>
		{/* Paper only: the footer carries the address on screen. */}
		<address class="print-only">{businessAddress.join(', ')}</address>
	</div>
</header>

<style>
	@layer components {
		/* Hero: fills the first screen with the name set large, so that the
		   first section's label sits just above the bottom of the viewport and
		   nothing below it shows. Font sizes are fixed (not fluid), in rem,
		   and step down at breakpoints. */
		header {
			--kicker-size: 0.98;
			--name-size: 6.75;
			--nav-size: 1.3;
			/* The gap from the name to the links, the lines the links take (2
			   on phones) and the gap between those lines. */
			--name-gap: var(--space-xl-2xl);
			/* The gap from the kicker down to the name. */
			--kicker-gap: var(--space-l);
			--nav-rows: 1;
			--nav-row-gap: var(--space-xs);
			/* The viewport less main's top padding, the section spacing, the
			   label (1.2rem trimmed to EB Garamond's 0.65em cap height) and a
			   gap under it, smaller than the label's own space-l gap to the
			   first entry so that entry stays out of view; at least 20rem on
			   short landscape screens. */
			--hero-h: max(
				20rem,
				calc(100svb - var(--space-xl-2xl) - var(--space-2xl-3xl) - 0.78rem - var(--space-m))
			);

			min-block-size: var(--hero-h);
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-block: var(--space-l);
		}
		/* Small capitals set as capitals at 70%, which is what the browser
		   synthesises for small-caps anyway (the font has no small-cap glyphs),
		   but drawn from the regular glyphs, so they scale smoothly in the
		   scroll animation instead of snapping between pixel sizes. Sizes are
		   the small-caps sizes × 0.7. */
		.kicker {
			text-transform: uppercase;
			font-size: calc(var(--kicker-size) * 1rem);
			letter-spacing: 0.143em;
		}
		/* The name in Jost Bold, the one sans-serif title against the
		   book's Garamond. */
		h1 {
			margin-block-start: var(--kicker-gap);
			font-family: var(--font-display);
			font-weight: 800;
			font-size: calc(var(--name-size) * 1rem);
			line-height: 0.92;
			letter-spacing: 0;
			/* Jost's letters carry 0.06em of side bearing; pull the U back so
			   its stem lines up with the kicker and links. */
			margin-inline-start: -0.06em;
		}
		nav {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: var(--space-xs) var(--space-s);
			margin-block-start: var(--name-gap);
			font-size: calc(var(--nav-size) * 1rem);
		}
		nav > * {
			text-box: trim-both cap alphabetic;
		}
		/* A middle dot, a touch heavier and larger than the text so it reads at
		   this size without becoming a full bullet. Enlarged with scale, from
		   the baseline, rather than font-size: 1.15em, which Safari resolves
		   against the wrong size while the nav's font-size animates; scale
		   also leaves the nav's height at the links' cap height. */
		.divider {
			color: var(--muted);
			font-weight: 600;
			scale: 1.15;
			transform-origin: center bottom;
		}
		@media screen and (max-width: 48rem) {
			header {
				--name-size: 5;
			}
		}
		@media screen and (max-width: 32rem) {
			header {
				--kicker-size: 0.805;
				/* Jost 800 is 5.7em wide: 3rem leaves a margin on a 320px phone. */
				--name-size: 3;
				--nav-size: 1.2;
				--nav-rows: 2;
			}
			/* Too narrow for every link on one line: CV and the email share
			   the first, the rest follow on the second, rather than leaving a
			   dot hanging at a line end. The dot between them becomes an
			   invisible full-width row break as tall as the row gap, with the
			   nav's own row gap dropped, so the rows sit one gap apart. */
			nav {
				row-gap: 0;
			}
			.row-break {
				flex-basis: 100%;
				block-size: var(--nav-row-gap);
				overflow: hidden;
				visibility: hidden;
				scale: none;
			}
		}

		.print-label {
			display: none;
		}
		/* On paper: the printed CV's header (name, contact line, business
		   address) instead of a screen-filling hero; the scroll animation is screen
		   only. The title is left out, as the entries carry it. */
		@media print {
			header {
				--name-size: 2.4;
				--nav-size: 1.2;
				--nav-rows: 1;
				min-block-size: 0;
				padding-block: 0;
			}
			.hero {
				display: flex;
				flex-direction: column;
			}
			.kicker {
				display: none;
			}
			/* The printed CV stays all Garamond, like the original. */
			h1 {
				margin-block-start: 0;
				font-family: var(--font-body);
				font-weight: 600;
				letter-spacing: -0.01em;
				margin-inline-start: 0;
			}
			nav {
				margin-block-start: var(--space-3xs);
				row-gap: var(--space-xs);
			}
			address {
				font-size: calc(var(--nav-size) * 1rem);
				font-style: normal;
			}
			.row-break {
				flex-basis: auto;
				block-size: auto;
				overflow: visible;
				visibility: visible;
				scale: 1.15;
			}
			/* The PDF link: pointless on the printed CV itself. */
			.screen-label,
			.screen-only {
				display: none;
			}
			.print-label {
				display: inline;
			}
		}

		/* Progressive enhancement: where scroll-driven animations are supported
		   (and motion is welcome), the hero stays in place while the content
		   scrolls up towards it, shrinking, rising towards the top and drawing
		   its lines together. The header keeps a fixed height and the .hero
		   inside it is sticky, so it is released, and scrolls away with the
		   page, when the first section reaches it at the normal section
		   spacing. The shrink ends at that same moment, so the section arrives
		   without any extra space. Elsewhere the static hero above is used as
		   is. */
		@supports (animation-timeline: scroll()) {
			@media screen and (prefers-reduced-motion: no-preference) {
				header {
					/* EB Garamond's cap height, 0.65em, for 1rem text. A constant
					   rather than 1cap in registered properties: Safari handed
					   children stale values of those. */
					--cap: 0.65rem;
					/* Jost's, 0.7em, for the name. */
					--cap-display: 0.7rem;
					/* Where the hero ends up, and its compact font sizes in rem. */
					--inset-end: var(--space-l);
					--kicker-compact: 0.77;
					--name-compact: 3.5;
					--nav-compact: 1.1;
					/* The compact gaps: kicker to name, name to links. */
					--kicker-gap-end: var(--space-s);
					--name-gap-end: var(--space-m);
					/* Heights of the full and compact hero: every line is trimmed to
					   its cap height (the nav's one or two rows apart by its row
					   gap), plus the gaps between lines. */
					--hero-full-h: calc(
						var(--cap) *
							(var(--kicker-size) + var(--nav-size) * var(--nav-rows)) +
							var(--cap-display) * var(--name-size) +
							var(--kicker-gap) + var(--name-gap) +
							(var(--nav-rows) - 1) * var(--nav-row-gap)
					);
					--hero-compact-h: calc(
						var(--cap) *
							(var(--kicker-compact) + var(--nav-compact) * var(--nav-rows)) +
							var(--cap-display) * var(--name-compact) +
							var(--kicker-gap-end) + var(--name-gap-end) +
							(var(--nav-rows) - 1) * var(--nav-row-gap)
					);
					/* Via a custom property so the minifier keeps animation-timeline
					   as its own declaration instead of folding it into the
					   animation shorthand, which doesn't accept it everywhere. */
					--timeline: scroll(root);
					/* Shrink until the release: the scroll at which the header's
					   bottom (main's top padding plus its height down the page)
					   meets the compact hero's bottom. */
					--range: 0
						calc(var(--space-xl-2xl) + var(--hero-h) - var(--inset-end) - var(--hero-compact-h));

					display: block;
					min-block-size: 0;
					block-size: var(--hero-h);
					padding-block: 0;
				}
				/* Pinned centred in the header, as in the static layout, then
				   drawn up towards the top. */
				.hero {
					position: sticky;
					inset-block-start: calc(var(--space-xl-2xl) + (var(--hero-h) - var(--hero-full-h)) / 2);
					animation-name: hero-top;
				}
				.hero,
				.kicker,
				h1,
				nav {
					/* Longhands: a nameless shorthand gets minified to animation: none. */
					animation-timing-function: linear;
					animation-fill-mode: both;
					animation-timeline: var(--timeline);
					animation-range: var(--range);
				}
				/* Each gap moves from the next line's margin-block-start to this
				   line's padding-block-end, set only by the animation (from --gap to
				   --gap-end): Safari leaves a spacing property at its start
				   value here when a normal rule on the element also sets it. */
				h1,
				nav {
					margin-block-start: 0;
				}
				.kicker {
					--gap: var(--kicker-gap);
					--gap-end: var(--kicker-gap-end);
				}
				h1 {
					--gap: var(--name-gap);
					--gap-end: var(--name-gap-end);
				}
				.kicker {
					animation-name: hero-kicker;
				}
				h1 {
					animation-name: hero-name;
				}
				nav {
					animation-name: hero-nav;
				}
				@keyframes hero-top {
					to {
						inset-block-start: var(--inset-end);
					}
				}
				@keyframes hero-kicker {
					from {
						padding-block-end: var(--gap);
					}
					to {
						padding-block-end: var(--gap-end);
						font-size: calc(var(--kicker-compact) * 1rem);
					}
				}
				/* The name also thins from Jost's 800 to 600 as it shrinks: a
				   compact extra-bold would look heavy. Weight changes width, not the
				   cap height, so the formulas are unaffected. */
				@keyframes hero-name {
					from {
						padding-block-end: var(--gap);
					}
					to {
						padding-block-end: var(--gap-end);
						font-size: calc(var(--name-compact) * 1rem);
						font-weight: 600;
					}
				}
				@keyframes hero-nav {
					to {
						font-size: calc(var(--nav-compact) * 1rem);
					}
				}
				@media (max-width: 48rem) {
					header {
						--name-compact: 3;
					}
				}
				@media (max-width: 32rem) {
					header {
						--name-compact: 2.25;
					}
				}
			}
		}
	}
</style>
