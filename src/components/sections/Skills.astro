---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';

const groups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<Section title="Technical Skills" printOnly>
	<dl>
		{
			groups.map(({ data }) => (
				<>
					<dt>{data.name}</dt>
					<dd>{data.items.join(', ')}</dd>
				</>
			))
		}
	</dl>
</Section>

<style>
	@layer components {
		dl {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: var(--space-s) var(--space-m);
		}
		dt {
			color: var(--rubric);
			font-variant-caps: all-small-caps;
			letter-spacing: 0.07em;
		}
		@media print {
			/* Kept on one page: a skill list split across pages reads as
			   two lists. */
			dl {
				gap: var(--space-3xs) var(--space-m);
				break-inside: avoid;
			}
			dt {
				font-variant-caps: normal;
				letter-spacing: 0;
				font-weight: 600;
			}
		}
		@media screen and (max-width: 32rem) {
			dl {
				grid-template-columns: 1fr;
				gap: var(--space-2xs-xs);
			}
			dd + dt {
				margin-block-start: var(--space-s);
			}
		}
	}
</style>
