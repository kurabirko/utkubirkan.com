---
interface Props {
	heading: string;
	headingNote?: string; // shown beside the heading in lighter text, e.g. honors
	subheading: string;
	dates: string;
	location?: string;
}

const { heading, headingNote, subheading, dates, location } = Astro.props;
---

<article>
	<h3>
		{heading}
		{headingNote && <span class="note">{headingNote}</span>}
	</h3>
	<p class="sub muted">{subheading}</p>
	<p class="meta">
		<span class="dates small-caps rubric">{dates}</span>
		{location && <span class="location muted">{location}</span>}
	</p>
	<div class="body">
		<slot />
	</div>
</article>

<style>
	@layer components {
		/* Narrow layout: everything in one column, dates and location on one line. */
		article {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'title'
				'sub'
				'meta'
				'body';
		}
		article + article {
			margin-top: var(--space-xl);
		}
		h3 {
			grid-area: title;
			font-size: 1.45rem;
		}
		.note {
			display: block;
			margin-top: var(--space-2xs);
			font-family: var(--font-body);
			font-size: 1.05rem;
			font-style: italic;
			color: var(--muted);
			text-box: trim-both cap alphabetic;
		}
		.sub {
			grid-area: sub;
			margin-top: var(--space-xs);
		}
		.meta {
			grid-area: meta;
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: var(--space-2xs) var(--space-s);
			margin-top: var(--space-xs);
			font-size: 1.05rem;
		}
		.meta > * {
			text-box: trim-both cap alphabetic;
		}
		.body {
			grid-area: body;
			margin-top: var(--space-m);
		}
		/* Visible gap between items must exceed the ~0.9em gap between lines
		   (1.55 line height minus cap height) or items blur together. */
		.body :global(li + li) {
			margin-top: 1.1em;
		}
		/* Technologies are marked as <strong> in the content; show them as a
		   tinted highlight instead of bold. */
		.body :global(strong) {
			font-weight: inherit;
			background: var(--tint);
			padding: 0.05em 0.2em;
			/* Most of the side padding hangs into the surrounding space, so
			   punctuation still sits close to the word. */
			margin-inline: -0.12em;
			border-radius: 2px;
			/* Keep padding and corners on every line when a keyword wraps. */
			-webkit-box-decoration-break: clone;
			box-decoration-break: clone;
		}

		/* Wide layout: dates and location hang in the left margin, right-aligned
		   against the heading, so the text column stays centred. Needs room for
		   the margin on both sides: measure + 2 × (margin + gutter + side). */
		@media (min-width: 70rem) {
			article {
				position: relative;
				grid-template-areas:
					'title'
					'sub'
					'body';
			}
			.note {
				display: inline;
				margin: 0 0 0 0.35em;
			}
			.meta {
				position: absolute;
				top: 0;
				right: calc(100% + var(--gutter));
				width: var(--margin);
				flex-direction: column;
				align-items: flex-end;
				gap: var(--space-xs);
				margin-top: 0;
				text-align: right;
				/* Line the date's cap height up with the heading's. */
				padding-top: 0.35rem;
			}
		}
	}
</style>
