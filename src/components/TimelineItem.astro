---
interface Props {
	heading: string;
	subheading: string;
	subheadingNote?: string; // second line under the subheading, same style, e.g. honors
	dates: string;
	location?: string;
}

const { heading, subheading, subheadingNote, dates, location } = Astro.props;
---

<article>
	<h3>{heading}</h3>
	<p class="sub muted">
		{subheading}
		{subheadingNote && <span class="note">{subheadingNote}</span>}
	</p>
	<p class="dates small-caps rubric">{dates}</p>
	{location && <p class="location muted">{location}</p>}
	<div class="body">
		<slot />
	</div>
</article>

<style>
	@layer components {
		/* Narrow layout: title, then the institution (plus any note as a second
		   line of the same paragraph), then dates and location sharing one line.
		   Rows align on baselines so mixed font sizes still sit on one line. */
		article {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'title title'
				'sub sub'
				'dates location'
				'body body';
			align-items: baseline;
			column-gap: var(--space-s);
		}
		article + article {
			margin-block-start: var(--space-xl);
		}
		h3 {
			grid-area: title;
			font-size: 1.45rem;
			font-weight: 600;
		}
		/* A second line in the same style, spaced by the paragraph's own line
		   height, so institution and note read as one block. */
		.note {
			display: block;
		}
		.sub {
			grid-area: sub;
			margin-block-start: var(--space-xs);
			/* Tighter leading so the gap between its lines (line height minus
			   cap height, ~0.65em) matches the title-to-institution gap. */
			line-height: 1.3;
		}
		.dates,
		.location {
			margin-block-start: var(--space-s);
			font-size: 1.05rem;
		}
		.dates {
			grid-area: dates;
		}
		.location {
			grid-area: location;
			text-align: end;
		}
		.body {
			grid-area: body;
			margin-block-start: var(--space-m);
		}
		/* Visible gap between items must exceed the ~0.9em gap between lines
		   (1.55 line height minus cap height) or items blur together. */
		.body :global(li + li) {
			margin-block-start: 1.1em;
		}
		/* Technologies are marked as <strong> in the content; show them as a
		   tinted highlight instead of bold. */
		.body :global(strong) {
			font-weight: inherit;
			background-color: var(--tint);
			padding-block: 0.05em;
			padding-inline: 0.2em;
			/* Most of the side padding hangs into the surrounding space, so
			   punctuation still sits close to the word. */
			margin-inline: -0.12em;
			border-radius: 2px;
			/* Keep padding and corners on every line when a keyword wraps. */
			-webkit-box-decoration-break: clone;
			box-decoration-break: clone;
		}
		/* Where the pointer can hover, the highlights appear only while the
		   entry (including its margin dates) is hovered or has keyboard focus.
		   Touch screens can't hover, so they keep the highlights visible. */
		@media (hover: hover) {
			.body :global(strong) {
				background-color: transparent;
			}
			article:hover .body :global(strong),
			article:focus-within .body :global(strong) {
				background-color: var(--tint);
			}
		}
		@media (hover: hover) and (prefers-reduced-motion: no-preference) {
			.body :global(strong) {
				transition: background-color 0.2s ease;
			}
		}

		/* Wide layout: the grid reaches left into the page margin, so dates and
		   location sit in a margin column beside the text, which stays centred.
		   The dates share the title's row and the location shares the
		   institution's, so baseline alignment puts each pair on one baseline.
		   Needs room for the margin on both sides:
		   measure + 2 × (margin + gutter + side). */
		@media (min-width: 74rem) {
			article {
				grid-template-columns: var(--margin) minmax(0, 1fr);
				grid-template-areas:
					'dates title'
					'location sub'
					'. body';
				column-gap: var(--gutter);
				margin-inline-start: calc(-1 * (var(--margin) + var(--gutter)));
			}
			.dates,
			.location {
				text-align: end;
			}
			.dates {
				margin-block-start: 0;
			}
			.location {
				margin-block-start: var(--space-xs);
			}
		}
	}
</style>
