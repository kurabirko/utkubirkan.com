---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section>
	<h2>{title}</h2>
	<slot />
</section>

<style>
	@layer components {
		section {
			margin-top: var(--space-2xl-3xl);
		}
		h2 {
			font-size: 2.2rem;
			/* The heading is trimmed to its baseline, so this padding is the
			   visible gap between the letters and the rule. */
			padding-bottom: var(--space-s);
			border-bottom: 1px solid var(--rubric);
			margin-bottom: var(--space-l-xl);
		}
		@media (max-width: 32rem) {
			h2 {
				font-size: 1.9rem;
			}
		}
	}
</style>
