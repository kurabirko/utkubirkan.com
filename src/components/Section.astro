---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section>
	<h2>{title}</h2>
	<slot />
</section>

<style>
	section {
		margin-top: 2.5rem;
	}
	h2 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
		padding-bottom: 0.5rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}
</style>
