---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section>
	<h2>{title}</h2>
	<slot />
</section>

<style>
	@layer components {
		section {
			margin-top: var(--space-xl-2xl);
		}
		h2 {
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--muted);
			padding-bottom: var(--space-xs);
			margin-bottom: var(--space-m-l);
			border-bottom: 1px solid var(--border);
		}
	}
</style>
