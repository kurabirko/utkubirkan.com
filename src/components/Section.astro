---
interface Props {
	title: string;
	printOnly?: boolean; // hidden on screen, shown when printed
}

const { title, printOnly = false } = Astro.props;
---

<section class:list={{ 'print-only': printOnly }}>
	<h2><span>{title}</span></h2>
	<slot />
</section>

<style>
	@layer components {
		section {
			margin-top: var(--space-2xl-3xl);
		}
		/* A quiet small-caps label, like the hero's title kicker, so the entry
		   titles below carry the visual weight. */
		h2 {
			font-size: 1.2rem;
			font-weight: 500;
			font-variant-caps: all-small-caps;
			font-variant-numeric: lining-nums;
			letter-spacing: 0.1em;
			color: var(--rubric);
			margin-bottom: var(--space-l);
			/* A hairline runs from the label to the column edge on its baseline,
			   marking the start of the section without underlining the label.
			   The label is trimmed to its baseline, so aligning to the end of
			   the row puts the line exactly on it. */
			display: flex;
			align-items: end;
			gap: var(--space-s);
		}
		/* Flex items carry their own trim; the heading's own trim doesn't reach
		   an anonymous flex item, so the label sits in a span. */
		h2 > span {
			text-box: trim-both cap alphabetic;
		}
		h2::after {
			content: '';
			flex: 1;
			/* The rubric at reduced strength: red in hue, but quieter than the label. */
			border-top: 1px solid color-mix(in oklch, var(--rubric) 35%, transparent);
		}
	}
</style>
